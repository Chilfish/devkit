{
  "name": "@chilfish/devkit",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "bun@1.4.4",
  "description": "Reusable local development infrastructure: CLI runtime, env layering, local Postgres, Neon /sql proxy and SILO storage.",
  "author": "Chilfish",
  "license": "MIT",
  "homepage": "https://github.com/Chilfish/devkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/devkit.git"
  },
  "bugs": "https://github.com/Chilfish/devkit/issues",
  "keywords": [
    "devkit",
    "cli",
    "postgres",
    "neon",
    "silo",
    "local-development"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./shared": {
      "import": {
        "types": "./dist/shared/index.d.ts",
        "default": "./dist/shared/index.js"
      },
      "require": {
        "types": "./dist/shared/index.d.cts",
        "default": "./dist/shared/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      },
      "require": {
        "types": "./dist/cli/index.d.cts",
        "default": "./dist/cli/index.cjs"
      }
    },
    "./env": {
      "import": {
        "types": "./dist/env/index.d.ts",
        "default": "./dist/env/index.js"
      },
      "require": {
        "types": "./dist/env/index.d.cts",
        "default": "./dist/env/index.cjs"
      }
    },
    "./local": {
      "import": {
        "types": "./dist/local/index.d.ts",
        "default": "./dist/local/index.js"
      },
      "require": {
        "types": "./dist/local/index.d.cts",
        "default": "./dist/local/index.cjs"
      }
    },
    "./proxy": {
      "import": {
        "types": "./dist/proxy/index.d.ts",
        "default": "./dist/proxy/index.js"
      },
      "require": {
        "types": "./dist/proxy/index.d.cts",
        "default": "./dist/proxy/index.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage/index.d.ts",
        "default": "./dist/storage/index.js"
      },
      "require": {
        "types": "./dist/storage/index.d.cts",
        "default": "./dist/storage/index.cjs"
      }
    },
    "./commands": {
      "import": {
        "types": "./dist/commands/index.d.ts",
        "default": "./dist/commands/index.js"
      },
      "require": {
        "types": "./dist/commands/index.d.cts",
        "default": "./dist/commands/index.cjs"
      }
    },
    "./pipeline": {
      "import": {
        "types": "./dist/pipeline/index.d.ts",
        "default": "./dist/pipeline/index.js"
      },
      "require": {
        "types": "./dist/pipeline/index.d.cts",
        "default": "./dist/pipeline/index.cjs"
      }
    },
    "./bin/proxy": "./dist/bin/proxy.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    ".env.example",
    "LICENSE.md",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run typecheck && bun run lint:check && bun run test:coverage && bun run build && bun run verify:package",
    "check:docs": "node scripts/check-docs.mjs",
    "example": "bun examples/basic.ts",
    "example:cli": "bun examples/cli.ts",
    "example:env": "bun examples/env.ts",
    "example:local": "bun examples/local.ts",
    "example:proxy": "bun examples/proxy.ts",
    "example:pipeline": "bun examples/pipeline.ts",
    "test:integration": "vitest run tests/integration",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:tag": "node scripts/verify-release-tag.mjs",
    "prepublishOnly": "bun run build",
    "release": "bumpp --commit \"chore(release): v{version}\" --tag --push",
    "prepare": "lefthook install"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0",
    "pg": ">=8.11.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@neondatabase/serverless": "^1.2.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.1",
    "bumpp": "^12.3.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.2.2",
    "pg": "^8.23.1",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
