# Copy to .env for local development, then adjust the values for your machine.
#
# Load order: .env, then .env.dev when LOCAL=1 or .env.prod when LOCAL=0.
# A missing mode file is skipped and variables already in the process
# environment always win.
#
# Never commit .env, .env.dev or .env.prod; this template is the committed one.

# 1 = this machine, 0 or unset = remote target. Local mode forces the
# database and proxy below back to localhost even if they differ here.
LOCAL=1

# Local Postgres, created by `dev db` / `dev server`.
DATABASE_URL=postgres://postgres@localhost:5432/devkit_dev
# Neon HTTP-compatible proxy; `dev proxy` serves it.
NEON_HTTP_ENDPOINT=http://127.0.0.1:4444/sql

# Local object storage (SILO / MinIO), started by `dev storage`.
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=silo-admin
S3_SECRET_ACCESS_KEY=silo-admin

# Optional. Both fall back to the config: R2_BUCKET to storage.bucket, the
# public base to S3_ENDPOINT + bucket. Setting R2_BUCKET here overrides
# storage.bucket, so only uncomment it to test another bucket.
# R2_BUCKET=devkit-local
# PUBLIC_BASE=http://127.0.0.1:9000/devkit-local
